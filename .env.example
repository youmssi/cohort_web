# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, used for canonical/hreflang metadata, OG images and the
# sitemap. No trailing slash. Defaults to the production domain when unset
# (see lib/constants.ts), so it only needs setting for preview environments.
NEXT_PUBLIC_SITE_URL=https://cohort.mrvin100.de

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Used by the Apply, Contact and Diagnostic Server Actions to notify the team.
# Leave RESEND_API_KEY unset in local dev: the service layer logs the message
# and the request still succeeds, so forms stay testable without sending mail.

# https://resend.com/api-keys. Sending permission is enough.
RESEND_API_KEY=

# The From address. MUST be on a domain verified in Resend, otherwise every
# send is rejected. The display name is part of the value, not a separate
# variable: Resend parses the "Name <address>" form.
#
# Verified domain: contact.mrvin100.de
RESEND_FROM_EMAIL=Coh0rt <admissions@contact.mrvin100.de>

# Where application, contact and diagnostic notifications are delivered. This
# is a To address, so it does NOT need to be on the verified domain: it needs
# to be a mailbox someone actually reads. Verifying a domain in Resend grants
# sending only, it does not create an inbox.
APPLICATION_NOTIFICATION_EMAIL=mrvin100mail@gmail.com

# ---------------------------------------------------------------------------
# Search Console (optional)
# ---------------------------------------------------------------------------
# The token from the "HTML tag" verification method, value only, without the
# surrounding meta tag. Omit it and no verification tag is emitted at all.
GOOGLE_SITE_VERIFICATION=
