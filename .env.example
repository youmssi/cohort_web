# Public site URL, used for canonical/hreflang metadata, OG images and sitemap.
# Defaults to the production domain when unset (see lib/constants.ts).
NEXT_PUBLIC_SITE_URL=https://cohort.mrvin100.de

# Resend (https://resend.com), used by the Diagnostic and Apply Server Actions
# to notify the program team. Leave unset in local dev: the service layer logs
# instead of sending and the request still succeeds.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where application and diagnostic notification emails are delivered.
APPLICATION_NOTIFICATION_EMAIL=
